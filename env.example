HOMEBUDGET_VERSION=2026.11.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_DB=budgetdb
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=3001
# Choose local for login, or explicitly none for a trusted LAN/VPN.
AUTH_MODE=local
# Username and password are set on first opening the app in your browser.
APP_ORIGIN=https://budget.example.org
AUTH_COOKIE_SECURE=true
# Dev only: target used by the Vite /api proxy.
VITE_API_URL=http://localhost:3000

# Optional: override complete image references, including tags/digests.
# BACKEND_IMAGE=ghcr.io/owner/home-budget-backend:2026.11.0
# FRONTEND_IMAGE=ghcr.io/owner/home-budget-frontend:2026.11.0
